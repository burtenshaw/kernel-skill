{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "webfetch": "deny",
    "bash": {
      "*": "deny"
    }
  },
  "agent": {
    "kernel-demo": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git rev-parse*": "allow",
          "git status*": "allow"
        },
        "task": {
          "*": "deny",
          "kernel-analyze": "allow",
          "kernel-publish": "allow",
          "kernel-bench": "allow"
        }
      }
    },
    "kernel-analyze": {
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git rev-parse*": "allow",
          "git status*": "allow"
        }
      }
    },
    "kernel-publish": {
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git rev-parse*": "allow",
          "git status*": "allow",
          "hf repo *": "allow",
          "hf whoami*": "allow",
          "kernels *": "allow",
          "nix *": "allow",
          "uv *": "allow",
          "uvx *": "allow"
        }
      }
    },
    "kernel-bench": {
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git rev-parse*": "allow",
          "git status*": "allow",
          "hf jobs *": "allow",
          "hf whoami*": "allow",
          "uv *": "allow",
          "uvx *": "allow"
        }
      }
    }
  }
}
